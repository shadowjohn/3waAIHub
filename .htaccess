Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:app|crontab|data|docs|i18n|packs|scripts|templates|tests|tools)(?:/|$) - [F,L]
RewriteRule ^(?:\.git|\.github|vendor|node_modules)(?:/|$) - [F,L]
RewriteRule ^(?:README\.md|history\.md|install\.sh|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L]
</IfModule>

<IfModule mod_setenvif.c>
SetEnvIfNoCase Authorization "^(.*)$" HTTP_AUTHORIZATION=$1
</IfModule>

<FilesMatch "(^\.|\.sqlite(?:-.+)?$|\.db$|\.env$|\.key$|\.log$|\.ps1$|\.bat$|\.cmd$|\.sh$|\.sql$|\.ini$|\.ya?ml$|\.xml$|\.bak$|~$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
