<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="index.php" />
            </files>
        </defaultDocument>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Content-Type-Options" />
                <add name="X-Content-Type-Options" value="nosniff" />
            </customHeaders>
        </httpProtocol>
        <directoryBrowse enabled="false" />
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".env.example" />
                    <add segment=".git" />
                    <add segment=".github" />
                    <add segment="app" />
                    <add segment="crontab" />
                    <add segment="data" />
                    <add segment="docs" />
                    <add segment="i18n" />
                    <add segment="packs" />
                    <add segment="scripts" />
                    <add segment="templates" />
                    <add segment="tests" />
                    <add segment="tools" />
                </hiddenSegments>
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".ps1" allowed="false" />
                    <add fileExtension=".bat" allowed="false" />
                    <add fileExtension=".cmd" allowed="false" />
                    <add fileExtension=".sh" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".sqlite" allowed="false" />
                    <add fileExtension=".db" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".ini" allowed="false" />
                    <add fileExtension=".yml" allowed="false" />
                    <add fileExtension=".yaml" allowed="false" />
                    <add fileExtension=".xml" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
