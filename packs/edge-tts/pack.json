{
  "schema_version": "0.1",
  "id": "edge-tts",
  "name": "Edge TTS External Service",
  "version": "0.3.0",
  "category": "audio",
  "type": "internal_task",
  "execution_type": "async_task",
  "runtime_level": "L5-benchmark-ready",
  "target_level": "L5-benchmark-ready",
  "runtime_ready": true,
  "default_mode": "edge_tts",
  "experimental": true,
  "description": "Experimental CPU-only text-to-speech adapter for Microsoft Edge's online speech service.",
  "runtime": {
    "kind": "internal_task"
  },
  "runner_build": {
    "context": "service",
    "dockerfile": "Dockerfile",
    "image": "3waaihub/edge-tts:0.3.0"
  },
  "gateway": {
    "invoke_path": "task_submit:pack_job",
    "methods": ["GET", "POST"],
    "timeout_sec": 180,
    "max_upload_mb": 1,
    "require_service_enabled": true
  },
  "l5_contract": {
    "endpoint": "api.php?mode=edge_tts",
    "method": "POST",
    "content_type": "application/x-www-form-urlencoded",
    "task_type": "pack_job",
    "input": {
      "fields": [
        {"name": "text", "type": "string", "required": true, "max_length": 4096},
        {"name": "voice", "type": "string", "required": false, "default": "zh-TW-HsiaoChenNeural", "enum": ["zh-TW-HsiaoChenNeural", "zh-TW-HsiaoYuNeural", "zh-TW-YunJheNeural", "zh-CN-XiaoxiaoNeural", "zh-CN-XiaoyiNeural", "zh-CN-YunjianNeural", "zh-CN-YunxiNeural", "zh-CN-YunxiaNeural", "zh-CN-YunyangNeural", "zh-CN-liaoning-XiaobeiNeural", "zh-CN-shaanxi-XiaoniNeural", "zh-HK-HiuGaaiNeural", "zh-HK-HiuMaanNeural", "zh-HK-WanLungNeural"]},
        {"name": "rate", "type": "string", "required": false, "default": "+0%", "enum": ["-50%", "-25%", "+0%", "+25%", "+50%"]},
        {"name": "volume", "type": "string", "required": false, "default": "+0%", "enum": ["-50%", "-25%", "+0%", "+25%", "+50%"]},
        {"name": "pitch", "type": "string", "required": false, "default": "+0Hz", "enum": ["-50Hz", "-25Hz", "+0Hz", "+25Hz", "+50Hz"]},
        {"name": "include_subtitles", "type": "boolean", "required": false, "default": false}
      ]
    },
    "output": {
      "required_keys": ["ok", "task_id", "status", "status_url", "result_url", "log_url", "cancel_url", "artifact_url_template"],
      "task_result": {
        "required_keys": ["ok", "task_id", "result"],
        "artifact_types": ["generated_audio", "synthesis_metadata", "subtitle_vtt", "subtitle_srt", "speech_timeline"]
      },
      "artifacts": [
        {"type": "generated_audio", "mime_type": "audio/mpeg", "required": true},
        {"type": "synthesis_metadata", "mime_type": "application/json", "required": true, "required_keys": ["provider", "client_version", "voice", "rate", "volume", "pitch", "format", "audio_bytes", "elapsed_seconds", "warnings"]},
        {"type": "subtitle_vtt", "mime_types": ["text/plain", "text/vtt"], "required": true},
        {"type": "subtitle_srt", "mime_types": ["text/plain", "application/x-subrip", "text/x-subrip", "text/srt"], "required": true},
        {"type": "speech_timeline", "mime_type": "application/json", "required": true, "required_keys": ["version", "unit", "duration_ms", "sentences", "words"]}
      ]
    },
    "errors": ["invalid_request", "pack_service_disabled", "runtime_not_ready", "upstream_unavailable", "edge_tts_timeout", "edge_tts_failed", "artifact_write_failed", "output_contract_invalid"],
    "limits": {
      "max_text_chars": 4096,
      "max_request_mb": 1,
      "gateway_timeout_seconds": 180,
      "task_timeout_seconds": 150,
      "queue": "cpu",
      "max_concurrency": 1,
      "gpu_required": false,
      "gpu_supported": false,
      "artifact_requirements": "generated_audio, synthesis_metadata, subtitle_vtt, subtitle_srt, speech_timeline when include_subtitles is true"
    },
    "benchmark": {
      "supported": true,
      "cases": [
        {"id": "edge_tts_async_complete", "name": "Edge TTS real async public-API acceptance", "type": "external_acceptance", "mode": "edge_tts", "method": "POST", "real_inference": true}
      ]
    }
  },
  "async_jobs": [
    {
      "job": "synthesize",
      "input": {
        "fields": ["text", "voice", "rate", "volume", "pitch", "include_subtitles"],
        "source_artifact_types": [],
        "source_required": false,
        "request_schema": {
          "text": {"type": "string", "required": true, "max_length": 4096},
          "voice": {"type": "string", "required": false, "enum": ["zh-TW-HsiaoChenNeural", "zh-TW-HsiaoYuNeural", "zh-TW-YunJheNeural", "zh-CN-XiaoxiaoNeural", "zh-CN-XiaoyiNeural", "zh-CN-YunjianNeural", "zh-CN-YunxiNeural", "zh-CN-YunxiaNeural", "zh-CN-YunyangNeural", "zh-CN-liaoning-XiaobeiNeural", "zh-CN-shaanxi-XiaoniNeural", "zh-HK-HiuGaaiNeural", "zh-HK-HiuMaanNeural", "zh-HK-WanLungNeural"], "default": "zh-TW-HsiaoChenNeural"},
          "rate": {"type": "string", "required": false, "enum": ["-50%", "-25%", "+0%", "+25%", "+50%"], "default": "+0%"},
          "volume": {"type": "string", "required": false, "enum": ["-50%", "-25%", "+0%", "+25%", "+50%"], "default": "+0%"},
          "pitch": {"type": "string", "required": false, "enum": ["-50Hz", "-25Hz", "+0Hz", "+25Hz", "+50Hz"], "default": "+0Hz"},
          "include_subtitles": {"type": "boolean", "required": false, "default": false}
        }
      },
      "runner": {
        "image": "3waaihub/edge-tts:0.3.0",
        "entrypoint": ["/app/edge-tts-entrypoint.sh", "/app/synthesize.py"],
        "args": [],
        "output_dir": "output",
        "accelerator": "cpu",
        "required_vram_mb": 0,
        "timeout_seconds": 150,
        "network_profile": "public_egress",
        "executor": "container"
      },
      "output": {
        "artifacts": [
          {
            "type": "generated_audio",
            "path": "generated_audio.mp3",
            "mime_types": ["audio/mpeg"],
            "max_bytes": 16777216,
            "audio": {}
          },
          {
            "type": "synthesis_metadata",
            "path": "synthesis_metadata.json",
            "mime_types": ["application/json"],
            "max_bytes": 65536,
            "json": {"required_keys": ["provider", "client_version", "voice", "rate", "volume", "pitch", "format", "audio_bytes", "elapsed_seconds", "warnings"]}
          },
          {
            "type": "subtitle_vtt",
            "path": "subtitle.vtt",
            "mime_types": ["text/plain", "text/vtt"],
            "max_bytes": 524288,
            "when": {"input": "include_subtitles", "equals": true},
            "text": {"max_bytes": 524288}
          },
          {
            "type": "subtitle_srt",
            "path": "subtitle.srt",
            "mime_types": ["text/plain", "application/x-subrip", "text/x-subrip", "text/srt"],
            "max_bytes": 524288,
            "when": {"input": "include_subtitles", "equals": true},
            "text": {"max_bytes": 524288}
          },
          {
            "type": "speech_timeline",
            "path": "speech_timeline.json",
            "mime_types": ["application/json"],
            "max_bytes": 524288,
            "when": {"input": "include_subtitles", "equals": true},
            "json": {"required_keys": ["version", "unit", "duration_ms", "sentences", "words"]}
          }
        ]
      }
    }
  ],
  "hardware": {
    "gpu_required": false,
    "gpu_supported": false,
    "min_vram_mb": 0
  },
  "queue": {
    "supported": true,
    "default_queue": "cpu",
    "max_concurrency": 1
  },
  "storage": {
    "mounts": []
  },
  "env": [],
  "preflight": {
    "checks": ["docker"]
  },
  "install": {
    "default_service_key": "edge-tts-main",
    "compose_project": "3waaihub_edge_tts"
  }
}
