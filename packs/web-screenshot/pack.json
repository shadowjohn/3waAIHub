{
  "schema_version": "0.1",
  "id": "web-screenshot",
  "name": "Web Screenshot",
  "version": "0.1.0",
  "category": "web",
  "type": "internal_task",
  "execution_type": "async_task",
  "runtime_level": "L1-contract",
  "runtime_ready": true,
  "default_mode": "web_capture",
  "description": "Capture a screenshot from one public HTTP or HTTPS URL.",
  "runtime": {
    "kind": "internal_task"
  },
  "gateway": {
    "invoke_path": "task_submit:pack_job",
    "methods": ["POST"],
    "timeout_sec": 300,
    "max_upload_mb": 1
  },
  "async_jobs": [
    {
      "job": "capture",
      "input": {
        "fields": ["url", "width", "height", "delay_seconds", "timeout_seconds", "javascript", "crop_x", "crop_y", "crop_width", "crop_height"],
        "source_artifact_types": [],
        "source_required": false,
        "request_schema": {
          "url": {"type": "string", "required": true, "max_length": 2048},
          "width": {"type": "integer", "required": false, "min": 320, "max": 2560, "default": 1280},
          "height": {"type": "integer", "required": false, "min": 320, "max": 2160, "default": 720},
          "delay_seconds": {"type": "integer", "required": false, "min": 0, "max": 60, "default": 0},
          "timeout_seconds": {"type": "integer", "required": false, "min": 10, "max": 120, "default": 60, "gt_field": "delay_seconds"},
          "javascript": {"type": "string", "required": false, "max_length": 16384},
          "crop_x": {"type": "integer", "required": false, "min": 0, "max": 2559, "requires_all": ["crop_y", "crop_width", "crop_height"]},
          "crop_y": {"type": "integer", "required": false, "min": 0, "max": 2159, "requires_all": ["crop_x", "crop_width", "crop_height"]},
          "crop_width": {"type": "integer", "required": false, "min": 1, "max": 2560, "requires_all": ["crop_x", "crop_y", "crop_height"]},
          "crop_height": {"type": "integer", "required": false, "min": 1, "max": 2160, "requires_all": ["crop_x", "crop_y", "crop_width"]}
        }
      },
      "runner": {
        "image": "3waaihub/web-screenshot:0.1.0",
        "entrypoint": ["/app/capture"],
        "args": [],
        "output_dir": "output",
        "accelerator": "cpu",
        "required_vram_mb": 0,
        "timeout_seconds": 300
      },
      "output": {
        "artifacts": [
          {
            "type": "screenshot",
            "path": "screenshot.png",
            "mime_types": ["image/png"],
            "max_bytes": 16777216,
            "image": {"format": "png", "max_width": 2560, "max_height": 2160, "max_pixels": 5529600}
          },
          {
            "type": "cropped_screenshot",
            "path": "cropped.png",
            "mime_types": ["image/png"],
            "max_bytes": 16777216,
            "image": {"format": "png", "max_width": 2560, "max_height": 2160, "max_pixels": 5529600},
            "when": {"all_present": ["crop_x", "crop_y", "crop_width", "crop_height"]}
          }
        ]
      }
    }
  ],
  "hardware": {
    "gpu_required": false
  },
  "queue": {
    "supported": true,
    "default_queue": "cpu",
    "max_concurrency": 1
  },
  "storage": {
    "mounts": []
  },
  "env": [],
  "preflight": {
    "checks": []
  },
  "install": {
    "default_service_key": "web-screenshot-main",
    "compose_project": "3waaihub_web_screenshot_main"
  }
}
