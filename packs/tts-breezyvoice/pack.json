{
  "schema_version": "0.1",
  "id": "tts-breezyvoice",
  "name": "BreezyVoice Taiwan Mandarin Clone",
  "version": "0.1.1",
  "category": "audio",
  "type": "api_service",
  "execution_type": "async_task",
  "runtime_level": "L2-container-runner",
  "target_level": "L5-benchmark-ready",
  "runtime_ready": true,
  "default_mode": "voice_generate_breezy",
  "capability": "taiwan_mandarin_voice_clone",
  "tts_modes": ["ultimate_clone"],
  "description": "BreezyVoice Taiwan Mandarin clone Pack for authorized, transcript-confirmed private Voice Profiles on Linux CUDA 12 GPUs.",
  "runtime": {
    "kind": "docker",
    "compose_file": "docker-compose.yml",
    "default_internal_port": 8000
  },
  "runner_build": {
    "context": ".",
    "dockerfile": "service/Dockerfile",
    "image": "3waaihub/tts-breezyvoice:0.1.1-cu128"
  },
  "platform_targets": {
    "linux-docker": {"supported": true}
  },
  "gateway": {
    "health_path": "/health",
    "invoke_path": "task_submit:pack_job",
    "methods": ["POST"],
    "timeout_sec": 7200,
    "max_upload_mb": 2,
    "require_service_enabled": true
  },
  "model_allowlist": {
    "breezyvoice_seed_policy": {
      "aliases": {
        "best_effort": {
          "model": "MediaTek-Research/BreezyVoice",
          "model_revision": "e33b502e0ac21c16b0ee0d00df66ac3fa737393d",
          "upstream_revision": "d592c9d3e8927a0f53f68616387060dcd32a05ea",
          "model_dir": "/models/breezyvoice",
          "seed_applied": false,
          "reproducibility": "best_effort",
          "device": "cuda",
          "sample_rate": 22050,
          "channels": 1,
          "sample_format": "pcm_s16le",
          "max_input_chars": 2000
        }
      }
    }
  },
  "async_jobs": [
    {
      "job": "synthesize",
      "input": {
        "fields": ["text", "mode", "voice_profile_id", "voice_profile_task_id", "seed", "seed_policy"],
        "source_artifact_types": [],
        "source_required": false,
        "request_schema": {
          "text": {"type": "string", "required": true, "max_length": 2000},
          "mode": {"type": "string", "required": true, "enum": ["ultimate_clone"], "max_length": 32},
          "voice_profile_id": {"type": "integer", "required": false, "min": 1, "max": 2147483647},
          "voice_profile_task_id": {"type": "string", "required": false, "max_length": 64},
          "seed": {"type": "integer", "required": false, "min": 0, "max": 2147483647},
          "seed_policy": {"type": "string", "required": false, "enum": ["best_effort"], "default": "best_effort", "max_length": 32}
        },
        "voice_context": {
          "mode_input": "mode",
          "ultimate_value": "ultimate_clone",
          "profile_input": "voice_profile_id",
          "profile_task_input": "voice_profile_task_id",
          "container_path": "/data/voice_profiles/reference.wav"
        }
      },
      "runner": {
        "image": "3waaihub/tts-breezyvoice:0.1.1-cu128",
        "entrypoint": ["/app/voice_generate.sh"],
        "args": ["{workspace}", "{input_dir}", "{output_dir}", "{input_dir}/runner_config.json"],
        "output_dir": "output",
        "accelerator": "gpu",
        "required_vram_mb": 4096,
        "timeout_seconds": 7200,
        "network_profile": "isolated",
        "executor": "container",
        "asset_mounts": [
          {
            "id": "breezyvoice_model",
            "storage": "models",
            "host_subdir": "breezyvoice",
            "container_path": "/models/breezyvoice",
            "required_paths": ["model-manifest.json"]
          }
        ]
      },
      "runner_config": {
        "alias_input": "seed_policy",
        "model_allowlist": "breezyvoice_seed_policy",
        "default_alias": "best_effort",
        "materializer": "breezyvoice_ultimate_v1"
      },
      "output": {
        "artifacts": [
          {
            "type": "generated_audio",
            "path": "generated_audio.wav",
            "mime_types": ["audio/wav", "audio/x-wav"],
            "max_bytes": 67108864,
            "audio": {}
          },
          {
            "type": "synthesis_metadata",
            "path": "synthesis_metadata.json",
            "mime_types": ["application/json"],
            "max_bytes": 1048576,
            "json": {
              "required_keys": ["model", "model_revision", "upstream_revision", "reference_audio_sha256", "transcript_sha256", "seed", "seed_applied", "reproducibility", "device", "final_format", "audio_sha256", "audio_size_bytes"],
              "semantic": {
                "field_types": {
                  "audio_sha256": "nonempty_string",
                  "audio_size_bytes": "positive_integer"
                },
                "object_properties": {
                  "final_format": {
                    "mime_type": "nonempty_string",
                    "sample_rate": "positive_integer",
                    "channels": "positive_integer",
                    "sample_format": "nonempty_string"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "hardware": {
    "gpu_required": true,
    "gpu_supported": true,
    "cpu_fallback": false,
    "min_vram_mb": 4096,
    "min_compute_capability": "12.0"
  },
  "lifecycle": {
    "lifecycle": "on_demand",
    "gpu_policy": "exclusive_gpu",
    "idle_unload_seconds": 0
  },
  "queue": {
    "supported": true,
    "default_queue": "gpu",
    "max_concurrency": 1
  },
  "storage": {
    "mounts": [
      {"type": "models", "host_subdir": "breezyvoice", "container_path": "/models/breezyvoice", "read_only": true},
      {"type": "cache", "host_subdir": "breezyvoice", "container_path": "/cache/breezyvoice", "read_only": false},
      {"type": "service_data", "host_subdir": "", "container_path": "/data/service", "read_only": false}
    ]
  },
  "env": [
    {"name": "BREEZYVOICE_MODEL_ID", "default": "MediaTek-Research/BreezyVoice", "required": true},
    {"name": "BREEZYVOICE_MODEL_REVISION", "default": "e33b502e0ac21c16b0ee0d00df66ac3fa737393d", "required": true},
    {"name": "BREEZYVOICE_UPSTREAM_REPOSITORY", "default": "https://github.com/mtkresearch/BreezyVoice.git", "required": true},
    {"name": "BREEZYVOICE_UPSTREAM_REVISION", "default": "d592c9d3e8927a0f53f68616387060dcd32a05ea", "required": true},
    {"name": "BREEZYVOICE_REAL_INFERENCE", "default": "1", "required": true},
    {"name": "BREEZYVOICE_DEVICE", "default": "cuda", "required": true},
    {"name": "BREEZYVOICE_SAMPLE_RATE", "default": "22050", "required": true},
    {"name": "BREEZYVOICE_MAX_INPUT_CHARS", "default": "2000", "required": true},
    {"name": "GPU_VISIBLE_DEVICES", "default": "all", "required": true}
  ],
  "preflight": {
    "checks": ["docker", "docker_compose", "nvidia_smi", "docker_gpus", "vram", "compute_capability", "storage"]
  },
  "service": {
    "default_local_port": 18111
  },
  "install": {
    "default_service_key": "tts-breezyvoice-main",
    "compose_project": "3waaihub_tts_breezyvoice_main"
  }
}
