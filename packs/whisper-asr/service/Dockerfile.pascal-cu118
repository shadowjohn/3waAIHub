FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN sed -i \
        -e 's|http://archive.ubuntu.com/ubuntu/|https://archive.ubuntu.com/ubuntu/|g' \
        -e 's|http://security.ubuntu.com/ubuntu/|https://security.ubuntu.com/ubuntu/|g' \
        /etc/apt/sources.list \
    && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        build-essential \
        ffmpeg \
        pkg-config \
        libavcodec-dev \
        libavdevice-dev \
        libavfilter-dev \
        libavformat-dev \
        libavutil-dev \
        libgomp1 \
        libswresample-dev \
        libswscale-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install --index-url https://download.pytorch.org/whl/cu118 \
        torch==2.7.0 torchaudio==2.7.0

# CUDA 11.8 的 Torch layer 約 2GB；讓 Pack requirements 的小改動不致使它失去快取。
COPY service/requirements.pascal-cu118.txt .
RUN python3 -m pip install 'Cython<3' \
    && python3 -m pip install --no-build-isolation 'av==10.0.0' \
    && python3 -m pip install -r requirements.pascal-cu118.txt \
    && python3 -m pip check

COPY service/app.py service/job.py service/offline_paths.py service/subtitle_reflow.py service/storage_smoke.py service/test_app.py service/provision_offline_assets.py ./
RUN python3 -m unittest -v test_app.py

COPY jobs/speech_transcribe.sh ./
RUN chmod 0755 /app/speech_transcribe.sh /app/provision_offline_assets.py \
    && ln -s /app/speech_transcribe.sh /app/speech-transcribe \
    && ln -s /app/provision_offline_assets.py /app/provision-offline-assets

EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
